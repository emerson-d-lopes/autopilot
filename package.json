{
  "name": "autopilot-chrome",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "MCP server driving Chrome through a Manifest V3 extension and the DevTools Protocol",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "autopilot-chrome": "./host/mcp-server.js"
  },
  "scripts": {
    "keygen": "node tools/gen-key.js",
    "install-host": "node tools/install.js",
    "uninstall-host": "node tools/install.js --uninstall",
    "doctor": "node tools/doctor.js",
    "log": "node tools/log.js",
    "icons": "node tools/icons.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "start": "node host/mcp-server.js",
    "browser": "node tools/browser.js --detach",
    "test:live": "node --test test/live.test.js",
    "test:resilience": "node --test test/resilience.test.js",
    "bench": "node tools/bench.js",
    "bench:screenshot": "node tools/bench-screenshot.js",
    "test:fast": "node --test --test-concurrency=1 --test-skip-pattern=\"survives|recovers when|resume a session|stale request\" \"test/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:versions": "node tools/check-versions.js",
    "check:errors-copy": "node tools/check-errors-copy.js",
    "check": "npm run lint && npm run format:check && npm run check:versions && npm run check:errors-copy && npm run test:coverage",
    "test:unit": "node tools/run-tests.js",
    "test:coverage": "node tools/run-tests.js --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emerson-d-lopes/autopilot.git"
  },
  "bugs": {
    "url": "https://github.com/emerson-d-lopes/autopilot/issues"
  },
  "homepage": "https://github.com/emerson-d-lopes/autopilot#readme",
  "files": [
    "host/",
    "extension/",
    "tools/",
    "README.md",
    "LICENSE"
  ]
}
