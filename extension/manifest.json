{
  "manifest_version": 3,
  "name": "Lantern",
  "version": "0.1.9",
  "description": "Drives this browser for a local MCP server, in the background, in its own tab group.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "scripting",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "nativeMessaging",
    "windows",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/agent.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "Lantern",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "short_name": "Lantern"
}
